{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TT Calendar",
  "mainBinaryName": "TT Calendar",
  "version": "2.5.2",
  "identifier": "com.tt.calendar",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TT Calendar",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8765 http://127.0.0.1:*; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8765 http://127.0.0.1:* http://localhost:8000 ws://localhost:5173 http://localhost:5173; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "shortDescription": "本地优先的日历与待办桌面应用",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../dist/tt-calendar-backend/": "backend/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/TTDiang2/TT_Calendar/releases/latest/download/latest.json",
        "https://ghfast.top/https://raw.githubusercontent.com/TTDiang2/TT_Calendar/main/latest-ghfast.json",
        "https://gh-proxy.com/https://raw.githubusercontent.com/TTDiang2/TT_Calendar/main/latest-ghproxy.json",
        "https://gitee.com/TTDiang/tt-calendar-update/raw/master/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFQUIyMjYzQTJEMDgyMjkKUldRcGd0Q2lZeUtyTG12Z0xza0ZWQjRVVWxIQTNYOWt0dHMxZGdXNExWWGZuaEFNcTdnVG1QMWwK"
    }
  }
}
